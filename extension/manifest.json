{
  "manifest_version": 3,
  "name": "Margin",
  "version": "0.2.0",
  "description": "Claude Code terminals in your browser's side panel.",
  "permissions": ["sidePanel", "storage", "tabs"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Margin" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+K", "mac": "Alt+Shift+K" },
      "description": "Open Margin"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:5250"
  }
}
